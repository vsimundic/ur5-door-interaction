<?xml version="1.0"?>
<robot name="ur5_robotiq_ft_3f" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ur_description)/urdf/inc/ur5_macro.xacro"/>
  <!-- <xacro:include filename="$(find robotiq_description)/urdf/robotiq_85_gripper.urdf.xacro" /> -->
  <!-- <xacro:robotiq-3f-gripper_articulated prefix=""/> -->
  <xacro:include filename="$(find robotiq_ft_sensor)/urdf/robotiq_ft300.urdf.xacro" />
  <!-- <xacro:include filename="$(find robotiq_3f_gripper_visualization)/cfg/robotiq-3f-gripper_articulated_fixed_pinch_open.urdf"/> -->
  <!-- <xacro:include filename="$(find robotiq_3f_gripper_visualization)/cfg/robotiq-3f-gripper_articulated_fixed_pinch_open_inflated.urdf"/> -->
  <xacro:include filename="$(find robotiq_3f_description)/urdf/robotiq_3f_gripper_macro.xacro"/>

  <xacro:ur5_robot prefix="" />

  <xacro:robotiq_ft300 parent="tool0" prefix="">
      <!-- This is the difference between the FT-300 and FT300-s which we have in a real-world setup -->
      <origin xyz="0 0 0.0067" rpy="0 0 0"/>
  </xacro:robotiq_ft300>
  
  <link name="gripper_coupler">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.017" />
      </geometry>
      <material name="Robotiq-Grey">
          <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.017" />
      </geometry>
    </collision>
  </link>

  <joint name="ft_sensor_gripper_coupler_joint" type="fixed">
    <!-- <origin xyz="0 0 0.0535" rpy="${-pi/2.0} ${-pi} ${-pi/4.0}" /> -->
    <!-- <origin xyz="0 0 0.0065" rpy="0 0 0" /> -->
    <origin xyz="0 0 -0.0085" rpy="${pi} 0 0" />
    <parent link="ft300_sensor"/>
    <child link="gripper_coupler"/>
  </joint>


  <xacro:robotiq_3f_gripper prefix="" parent="gripper_coupler">
    <origin xyz="0 0 0.0127" rpy="${pi/2} 0 ${-pi/4}"/>
  </xacro:robotiq_3f_gripper>


  <!-- <joint name="gripper_coupler_robotiq_3f_joint" type="fixed">
    origin xyz="0 0 ${0.0535 + 0.0065}" rpy="${pi/2.0} ${0} ${-pi/4.0}" />
    <origin xyz="0 0 ${0.0535 + 0.013 + 0.004}" rpy="${pi/2.0} ${0} ${-pi/4.0}" />
    <parent link="gripper_coupler"/>
    <child link="palm"/>
  </joint> -->

  <link name="camera_link">
      <visual>
          <origin rpy="0 0 0" xyz="0 0 0" />
          <geometry>
              <mesh filename="package://intel_realsense_l515/meshes/visual/l515.stl" />
          </geometry>
          <material name="yellow">
              <color rgba="1 1 0 1" />
          </material>
      </visual>
      <collision>
          <origin rpy="0 0 0" xyz="0 0 0" />
          <geometry>
              <mesh filename="package://intel_realsense_l515/meshes/collision/l515.stl" />
          </geometry>
      </collision>
      <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia
          ixx="0.0001027"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0001027"
          iyz="0.0"
          izz="0.0001442"/>
      </inertial>
  </link>
<!-- 
  <joint name="camera_joint" type="fixed">
      <origin rpy="0.0033192 -0.0293569 2.3598604" xyz="-0.07941524 -0.08149755 0.0608904" />
      <parent link="tool0" />
      <child link="camera_link" />
  </joint> -->
  <joint name="camera_joint" type="fixed">
      <!-- This pose is used when the camera is rotated 180 deg about z-axis of tool0 -->
      <!-- <origin rpy="0.0033192 -0.0293569 -0.7817323" xyz="-0.07941524 -0.08149755 0.0608904" /> --> 
      <!-- <origin rpy="-0.0148411 0.0319087 2.3663088" xyz="0.07985568832444188 0.08353177092684139 0.059728059869907146" /> -->
      <origin rpy="-0.0148411 0.0319087 -0.785398" xyz="0.07985568832444188 0.08353177092684139 0.059728059869907146" />
      <parent link="tool0" />
      <child link="camera_link" />
  </joint>

  <link name="gripper_power_plug">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.008" length="0.048" />
      </geometry>
      <material name="Robotiq-Grey">
          <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.048" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

  <link name="gripper_ethernet_plug">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.008" length="0.048" />
      </geometry>
      <material name="Robotiq-Grey">
          <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.048" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

  <joint name="gripper_power_plug_joint" type="fixed">
    <origin xyz="0.09 -0.035 0.025" rpy="${pi/2} 0 0" />
    <parent link="AGS_palm"/>
    <child link="gripper_power_plug"/>
  </joint>

  <joint name="gripper_ethernet_plug_joint" type="fixed">
    <origin xyz="0.09 -0.035 -0.025" rpy="${pi/2} 0 0" />
    <parent link="AGS_palm"/>
    <child link="gripper_ethernet_plug"/>
  </joint>

  <!-- Small marker sphere 0.275 m along tool0 +Z (visual only) -->
  <!-- <link name="tool0_marker_sphere">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.001" />
      </geometry>
      <material name="red">
          <color rgba="1 0 0 1" />
      </material>
    </visual>
  </link> -->

  <!-- <joint name="tool0_marker_sphere_joint" type="fixed">
    <origin xyz="-0.05303300858 0.05303300858 0.275" rpy="0 0 0" />
    <parent link="tool0" />
    <child link="tool0_marker_sphere" />
  </joint> -->

  <!-- Tactile sensor relative to gripper_coupler -->
  <link name="tactile_sensor">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.0246 0.0246 0.006" />
      </geometry>
      <material name="blue">
          <color rgba="0 0 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.0246 0.0246 0.006" />
      </geometry>
    </collision>
  </link>

  <joint name="tactile_sensor_joint" type="fixed">
    <origin xyz="${-sin(radians(45))*0.075} ${sin(radians(45))*0.075} ${0.275-0.0246/2}"  
            rpy="${radians(90)} 0 ${radians(45)}" />
    <parent link="tool0" />
    <child link="tactile_sensor" />
  </joint>

  <link name="world" />
  <joint name="virtual_joint" type="fixed">
    <parent link="world" />
    <child link = "base_link" />
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>


  <!-- Load gazebo_ros_control -->
  <!-- <xacro:include filename="$(find ur5_description)/urdf/common.gazebo.xacro" /> -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
    </plugin>
  </gazebo>

  <!-- Make the gripper, FT sensor and tactile sensor black in Gazebo -->
  <xacro:macro name="gazebo_black" params="link">
    <gazebo reference="${link}">
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <!-- Robotiq 3F gripper -->
  <xacro:gazebo_black link="AGS_palm" />
  <xacro:gazebo_black link="AGS_wrist" />
  <xacro:gazebo_black link="AGS_finger-base" />
  <xacro:gazebo_black link="AGS_finger-prox" />
  <xacro:gazebo_black link="AGS_finger-med" />
  <xacro:gazebo_black link="AGS_finger-dist" />
  <xacro:gazebo_black link="AGS_finger-base001" />
  <xacro:gazebo_black link="AGS_finger-prox001" />
  <xacro:gazebo_black link="AGS_finger-med001" />
  <xacro:gazebo_black link="AGS_finger-dist001" />
  <xacro:gazebo_black link="AGS_finger-base002" />
  <xacro:gazebo_black link="AGS_finger-prox002" />
  <xacro:gazebo_black link="AGS_finger-med002" />
  <xacro:gazebo_black link="AGS_finger-dist002" />

  <!-- Force-torque sensor -->
  <xacro:gazebo_black link="ft300_sensor" />
  <xacro:gazebo_black link="ft300_mounting_plate" />

  <!-- Tactile sensor -->
  <xacro:gazebo_black link="tactile_sensor" />

</robot>
