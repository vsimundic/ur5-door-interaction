<launch>

  <arg name="config_path" default="$(find multi_contact_force)/cfg/config.yaml"/>

  <!-- Door Detection Service -->
  <node name="detect_door_model_srv"
        pkg="door_detection"
        type="detect_door_model_srv.py"
        output="screen"
        required="true">
    <param name="config_path" value="$(arg config_path)"/>
  </node>

  <!-- Multi-Contact Path Planning Service -->
  <node name="multi_contact_path_planning_srv"
        pkg="path_planning"
        type="multi-contact_path_planning_srv.py"
        output="screen"
        required="true">
    <param name="config_path" value="$(arg config_path)"/>
  </node>

</launch>