        {
            "name": "Python Debug (rospy script)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "/home/RVLuser/rvl-linux/python/build/lib:/home/RVLuser/ferit_ur5_ws/devel/lib/python3/dist-packages:/opt/ros/noetic/lib/python3/dist-packages:${env:PYTHONPATH}",
                "LD_LIBRARY_PATH": "/home/RVLuser/ferit_ur5_ws/devel/lib:/opt/ros/noetic/lib:${env:LD_LIBRARY_PATH}",
                "ROS_PACKAGE_PATH": "/home/RVLuser/ferit_ur5_ws/src:/opt/ros/noetic/share",
                "ROS_MASTER_URI": "http://localhost:11311",
                "ROS_ROOT": "/opt/ros/noetic/share/ros",
                "ROS_DISTRO": "noetic",
                "ROSLISP_PACKAGE_DIRECTORIES": "/home/RVLuser/ferit_ur5_ws/devel/share/common-lisp"
            }
        },
        {
            "name": "Attach to Python (C++ Debug)",
            "type": "cppdbg",
            "request": "attach",
            "program": "/usr/bin/python3",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "additionalSOLibSearchPath": "/home/RVLuser/ferit_ur5_ws/devel/lib:/home/RVLuser/rvl-linux/python/build/lib",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        // Attach the Python debugger to ANY running roslaunch node.
        // Run roslaunch first, then pick the python3 process you want
        // (type part of the script name, e.g. "detect_door", to filter).
        {
            "name": "Attach to ROS Python node (by PID)",
            "type": "debugpy",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "justMyCode": false
        }
    ]
